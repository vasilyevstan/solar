# Replace with your inverter/dongle LAN address. This file is not loaded automatically.
SOLAR_INVERTER_HOST=192.0.2.10
SOLAR_INVERTER_PORT=502
SOLAR_INVERTER_UNIT_ID=1

# Optional: bind the server to a known device across process restarts.
# SOLAR_EXPECTED_SERIAL=your-inverter-serial

# Opt-in percentage/fixed-watt cap control. Requires SOLAR_EXPECTED_SERIAL.
# Leave disabled unless you intend to let the MCP client change generation.
SOLAR_ALLOW_CONTROL=0
# Optional absolute path; default: ~/.local/state/solar-mcp/generation-caps.jsonl
# SOLAR_CONTROL_LOG=/absolute/private/path/generation-caps.jsonl
# Only if the inverter requires installer authentication; never send this to an MCP tool.
# SOLAR_INSTALLER_PASSWORD=your-local-installer-password
