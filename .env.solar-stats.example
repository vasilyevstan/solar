# Use the selected plant's authenticated FusionSolar page, without login tokens.
SOLAR_STATS_PLANT_URL=https://your-region.fusionsolar.huawei.com/uniportal/pvmswebsite/assets/build/cloud.html#/view/station/NE=123456/overview
# Dedicated profile only, never your normal Chrome profile.
SOLAR_STATS_PROFILE_DIR=/absolute/private/path/solar-stats-browser
SOLAR_STATS_TIMEOUT_SECONDS=300
# Existing yearly CSVs and metadata; defaults to state/solar-stats under the working directory.
SOLAR_STATS_DATA_DIR=/absolute/private/path/solar-stats-data
# Required only for hourly queries; must match the plant report's IANA time zone.
# SOLAR_STATS_TIMEZONE=Europe/Helsinki
# attach reuses a running browser; managed starts/closes installed Chrome for each query.
SOLAR_STATS_BROWSER_MODE=attach
SOLAR_STATS_HEADLESS=true
# Optional macOS login; reads an existing generic-password entry, never creates one.
# SOLAR_STATS_KEYCHAIN_SERVICE=solar-stats.fusionsolar
# No passwords, copied cookies, or authentication tokens belong in this file.

# Optional: execute live portal reads in an owned PRIVATE GitHub Actions repository.
# File hits remain local and do not contact GitHub, start Chrome, or read Keychain.
SOLAR_STATS_BACKEND=browser
# SOLAR_STATS_BACKEND=github_actions
# SOLAR_STATS_ACTIONS_REPOSITORY=your-owner/private-solar-runner
# SOLAR_STATS_ACTIONS_SOURCE_SHA=the-40-character-source-commit-pinned-in-the-workflow
# SOLAR_STATS_GH_COMMAND=/absolute/path/to/gh
# Allow cold runner startup when using Actions: SOLAR_STATS_TIMEOUT_SECONDS=600
# On the Actions runner only: SOLAR_STATS_LOGIN_SOURCE=environment, with
# SOLAR_STATS_USERNAME and SOLAR_STATS_PASSWORD injected from GitHub Secrets.
